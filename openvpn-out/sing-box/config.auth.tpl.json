{
  "log": {
    "level": "${SING_BOX_LOG_LEVEL}"
  },
  "dns": {
    "servers": [
      {
        "type": "https",
        "tag": "remote",
        "server": "${DNS_SERVER}",
        "server_port": ${DNS_SERVER_PORT},
        "path": "${DNS_PATH}",
        "tls": {
          "server_name": "${DNS_TLS_SERVER_NAME}"
        },
        "detour": "${DNS_DETOUR}"
      }
    ],
    "rules": [
      {
        "action": "route",
        "server": "remote",
        "strategy": "${DNS_STRATEGY}"
      }
    ],
    "final": "remote"
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "interface_name": "${SING_TUN_NAME}",
      "address": [
        "${SING_TUN_ADDRESS}"
      ],
      "mtu": ${SING_TUN_MTU},
      "auto_route": false,
      "strict_route": false,
      "stack": "${SING_TUN_STACK}",
      "sniff": false
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    },
    {
      "type": "socks",
      "tag": "proxy",
      "server": "${PROXY_HOST}",
      "server_port": ${PROXY_PORT},
      "username": "${PROXY_USER}",
      "password": "${PROXY_PASS}",
      "udp_over_tcp": ${PROXY_UDP_OVER_TCP}
    }
  ],
  "route": {
    "rules": [
      {
        "protocol": "dns",
        "action": "hijack-dns"
      }
    ],
    "final": "proxy",
    "auto_detect_interface": true
  }
}
