{
  "log": {
    "level": "${SING_BOX_LOG_LEVEL}"
  },
  "dns": {
    "servers": [
      {
        "type": "https",
        "tag": "remote",
        "server": "${DNS_SERVER}",
        "server_port": ${DNS_SERVER_PORT},
        "path": "${DNS_PATH}",
        "tls": {
          "server_name": "${DNS_TLS_SERVER_NAME}"
        },
        "detour": "proxy"
      }
    ],
    "rules": [
      {
        "action": "route",
        "server": "remote",
        "strategy": "${DNS_STRATEGY}"
      }
    ],
    "final": "remote"
  },
  "inbounds": [
    {
      "type": "direct",
      "tag": "dns-in-udp",
      "listen": "0.0.0.0",
      "listen_port": 53,
      "network": "udp"
    },
    {
      "type": "direct",
      "tag": "dns-in-tcp",
      "listen": "0.0.0.0",
      "listen_port": 53,
      "network": "tcp"
    },
    {
      "type": "tproxy",
      "tag": "tproxy-in",
      "listen": "0.0.0.0",
      "listen_port": ${TPROXY_PORT},
      "network": "tcp",
      "sniff": false
    },
    {
      "type": "tproxy",
      "tag": "tproxy-in-udp",
      "listen": "0.0.0.0",
      "listen_port": ${TPROXY_PORT},
      "network": "udp",
      "sniff": false
    }
  ],
  "outbounds": [
    {
      "type": "socks",
      "tag": "proxy",
      "server": "${PROXY_HOST}",
      "server_port": ${PROXY_PORT},
      "udp_over_tcp": ${PROXY_UDP}
    }
  ],
  "route": {
    "rules": [
      {
        "inbound": ["dns-in-udp", "dns-in-tcp"],
        "action": "hijack-dns"
      }
    ],
    "final": "proxy"
  }
}
